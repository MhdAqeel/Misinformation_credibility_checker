# Server Configuration
PORT=8080

# Primary AI Provider: Google Gemini
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Fallback AI Provider: Groq
# High-speed secondary LLM provider when Gemini encounters rate limits (429) or transient outages
# Get your API key from Groq Console: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Debug & Resilience Testing Flag
# Set to 'true' to simulate Gemini failure and test automatic Groq failover
FORCE_GEMINI_FAIL=false
